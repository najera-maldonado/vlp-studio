# Nanocapsule Designer - Environment Configuration
# Copy this file to .env and adjust values as needed

# Flask Configuration
FLASK_APP=src/web/app.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Paths Configuration
INPUT_DIR=./Input
OUTPUT_DIR=./Output
CONFIG_DIR=./config
TEMP_DIR=./temp

# Packmol Configuration
PACKMOL_EXECUTABLE=packmol
PACKMOL_TIMEOUT=300

# PyMOL Configuration
PYMOL_EXECUTABLE=pymol
PYMOL_HEADLESS=true
PYMOL_QUIET=true

# Experiment Configuration
DEFAULT_N_REPLICAS=7
MAX_ENZYMES=50
EXCLUSION_RADIUS=10.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=nanocapsule.log

# API Configuration
API_RATE_LIMIT=100
ENABLE_CORS=true

# Optional: External Services
# DATABASE_URL=sqlite:///experiments.db
# REDIS_URL=redis://localhost:6379

# Development Settings
AUTO_RELOAD=true
TESTING=false

# Performance Settings
MAX_WORKERS=4
ENABLE_CACHE=true
CACHE_TIMEOUT=300