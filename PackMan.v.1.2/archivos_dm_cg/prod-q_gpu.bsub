#BSUB -q q_gpu_v100
#BSUB -n 4
#BSUB -o STD_PR-prod.OUT
#BSUB -e STD_PR-prod.ERR

source /tmpu/scunam/config/tipo_nodo.sh
module purge
module load asigna/1_gpu
module load amber/22_gpu

# Lanza el protocolo SIRAH completo (em1 -> em2 -> eq1 -> eq2 -> prod en trozos)
# sobre el sistema del directorio actual. run_MD.sh es reanudable: si el job se
# corta por limite de cola, volver a enviarlo continua desde la etapa pendiente.
# NAME se autodetecta de capside-*-cg-WAT.prmtop; exportarlo si hay varios.
date
NCHUNKS=${NCHUNKS:-10} bash run_MD.sh cuda ${NAME:-}
date
